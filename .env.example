# LUMINA orchestration (local development only; never use this file as production configuration)
LUMINA_ENV=development
LUMINA_API_PORT=8100
ARCHIVE_API_PORT=8200
WEARABLES_API_PORT=8300
PROMOP_API_PORT=8000

# Core-managed checkout cache for pinned component revisions. Keep this relative
# path unless you intentionally want to store component sources elsewhere.
LUMINA_COMPONENTS_DIR=.lumina/components

# LUMINA Archive database
ARCHIVE_DB_NAME=lumina_archive
ARCHIVE_DB_USER=lumina
ARCHIVE_DB_PASSWORD=lumina_local_only
ARCHIVE_DB_HOST=archive-db
ARCHIVE_DB_PORT=5432
ARCHIVE_DATABASE_URL=postgresql+psycopg://lumina:lumina_local_only@archive-db:5432/lumina_archive
ARCHIVE_BUCKET=lumina-local
# Local Archive uses a private Docker volume. Leave the bearer token empty only
# for local development; set it before using protected object/dataset endpoints.
ARCHIVE_OBJECT_STORE_BACKEND=filesystem
ARCHIVE_OBJECT_STORE_ROOT=/var/lib/lumina-archive
ARCHIVE_BEARER_TOKEN=
ARCHIVE_MAX_REQUEST_BYTES=26214400
# Disabled only in local development. Production must set a positive value and
# enforce a global per-identity/IP limit again at the TLS ingress.
ARCHIVE_RATE_LIMIT_REQUESTS_PER_MINUTE=0
# Production uses an encrypted S3-compatible bucket accessed through workload
# identity. These values are intentionally blank in local development.
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_PREFIX=lumina-archive
ARCHIVE_S3_ENDPOINT_URL=
ARCHIVE_S3_SSE=
ARCHIVE_S3_KMS_KEY_ID=

# Service-to-service URLs (use Compose service names, never localhost)
ARCHIVE_BASE_URL=http://archive:8200
PROMOP_BASE_URL=http://promop:8000
PROMOP_API_BASE=/api/v1/
WEARABLES_BASE_URL=http://wearables:8300

# PRomop Docker configuration, mapped from ../promop/.env.example
PROMOP_POSTGRES_USER=promop
PROMOP_POSTGRES_PASSWORD=promop
PROMOP_POSTGRES_DB=promop
PROMOP_SECRET_KEY=dev-secret-key-change-in-production
PROMOP_DEBUG=True
PROMOP_ADMIN_EMAIL=admin@example.org
PROMOP_ADMIN_PASSWORD=change-me
PROMOP_APP_BASE_URL=http://localhost:8000
PROMOP_PUBLIC_URL=http://localhost:8000
# Shared Archive/Wearables -> PRomop service credential. Replace outside local development.
PROMOP_SERVICE_AUTH_TOKEN=lumina-local-promop-service-token
PROMOP_REQUEST_TIMEOUT_SECONDS=30
# Credential required by callers of the protected Wearables -> PRomop export
# route. This is separate from the credential Wearables uses to call PRomop.
LUMINA_WEARABLES_EXPORT_TOKEN=lumina-local-wearables-export-token

# Optional separately deployed Open Wearables API. The base URL must include
# /api/v1 (for example https://open-wearables.example/api/v1). Never commit a
# real API key. The default development stack does not start Open Wearables;
# it has its own OAuth, admin, database, Redis, and worker lifecycle.
OPEN_WEARABLES_BASE_URL=
OPEN_WEARABLES_API_KEY=
