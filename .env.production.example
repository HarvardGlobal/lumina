# Template only: copy required values into a secret manager or deployment
# environment. Never commit a populated production .env file.
LUMINA_ENV=production
LUMINA_COMPONENTS_DIR=.lumina/components

# No service port is published by compose.production.yaml. An authenticated TLS
# gateway owned by the deployment environment joins the private application
# network instead.
LUMINA_API_PORT=8100
ARCHIVE_API_PORT=8200
WEARABLES_API_PORT=8300
PROMOP_API_PORT=8000

ARCHIVE_DB_NAME=lumina_archive
ARCHIVE_DB_USER=lumina
ARCHIVE_DB_PASSWORD=REPLACE_WITH_20_OR_MORE_RANDOM_CHARACTERS
ARCHIVE_DB_HOST=archive-db
ARCHIVE_DB_PORT=5432
ARCHIVE_DATABASE_URL=postgresql+psycopg://lumina:REPLACE_WITH_URL_ENCODED_PASSWORD@archive-db:5432/lumina_archive
ARCHIVE_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
ARCHIVE_BEARER_TOKEN=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
ARCHIVE_MAX_REQUEST_BYTES=26214400
ARCHIVE_RATE_LIMIT_REQUESTS_PER_MINUTE=120
ARCHIVE_OBJECT_STORE_BACKEND=s3
ARCHIVE_S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
ARCHIVE_S3_PREFIX=lumina-archive
# Leave empty for AWS S3; set only for an approved private S3-compatible endpoint.
ARCHIVE_S3_ENDPOINT_URL=
ARCHIVE_S3_SSE=aws:kms
ARCHIVE_S3_KMS_KEY_ID=REPLACE_WITH_KMS_KEY_ARN_OR_ID

ARCHIVE_BASE_URL=http://archive:8200
PROMOP_BASE_URL=http://promop:8000
PROMOP_API_BASE=/api/v1/
WEARABLES_BASE_URL=http://wearables:8300

PROMOP_POSTGRES_USER=promop
PROMOP_POSTGRES_PASSWORD=REPLACE_WITH_20_OR_MORE_RANDOM_CHARACTERS
PROMOP_POSTGRES_DB=promop
PROMOP_SECRET_KEY=REPLACE_WITH_50_OR_MORE_RANDOM_CHARACTERS
PROMOP_DEBUG=False
PROMOP_ADMIN_EMAIL=REPLACE_WITH_NAMED_ADMIN_EMAIL
PROMOP_ADMIN_PASSWORD=REPLACE_WITH_20_OR_MORE_RANDOM_CHARACTERS
PROMOP_APP_BASE_URL=https://promop.example.org
PROMOP_PUBLIC_URL=https://promop.example.org
PROMOP_SERVICE_AUTH_TOKEN=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
PROMOP_REQUEST_TIMEOUT_SECONDS=30

OPEN_WEARABLES_BASE_URL=
OPEN_WEARABLES_API_KEY=
